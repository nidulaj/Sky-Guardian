# ============================================================
# SKYGUARDIAN AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# APP SETTINGS
APP_NAME=
ENVIRONMENT=
LOG_LEVEL=

# BACKEND SERVER
HOST=
PORT=

# DATABASE CONFIGURATION (PostgreSQL + pgvector)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=
DATABASE_URL=

# SECURITY & AUTHENTICATION
JWT_SECRET=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=

# LLM PROVIDER ABSTRACTION
# Options: gemini, openai, mock
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# TAVILY WEB RETRIEVAL
TAVILY_API_KEY=

# FLIGHT DATA PROVIDER ABSTRACTION
# Options: mock, flightaware, aviationstack
FLIGHT_PROVIDER=
FLIGHT_API_KEY=
USE_MOCK_FLIGHTS=

# WEATHER PROVIDER ABSTRACTION
# Options: mock (demo data, default), open_meteo (live hourly forecast, no API key needed)
WEATHER_PROVIDER=
WEATHER_API_KEY=
# Open-Meteo tuning (these are the defaults from backend/app/config.py)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=8
WEATHER_CACHE_TTL_SECONDS=600

# RAG & KNOWLEDGE RETRIEVAL CONFIGURATION
RAG_ENABLED=true
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.40
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80
RAG_MAX_CONTEXT_LENGTH=3000
# Embedding options: mock, gemini, openai
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=models/text-embedding-004
# Knowledge store options: memory, pgvector
KNOWLEDGE_STORE_BACKEND=memory

# FRONTEND PUBLIC VARIABLES (Exposed to browser client)
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_API_URL=
